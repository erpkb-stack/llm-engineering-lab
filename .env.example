# ---------------------------------------------------------------------------
# LLM Engineering Lab — environment configuration (copy to .env)
# All variables are prefixed LLMLAB_. Defaults shown are used when unset.
# ---------------------------------------------------------------------------

# development | test | production   (production enforces the guards below)
LLMLAB_ENVIRONMENT=development
LLMLAB_LOG_LEVEL=INFO
LLMLAB_LOG_JSON=true

# --- Security ---------------------------------------------------------------
# REQUIRED in production (>= 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset in development, a random key is generated per process (sessions reset on restart).
LLMLAB_SECRET_KEY=
LLMLAB_ACCESS_TOKEN_MINUTES=60
LLMLAB_REMEMBER_ME_DAYS=14
# Must be true in production (HTTPS only cookies)
LLMLAB_COOKIE_SECURE=false
LLMLAB_COOKIE_SAMESITE=lax
LLMLAB_LOGIN_MAX_ATTEMPTS=5
LLMLAB_LOGIN_LOCKOUT_SECONDS=300
# JSON list, only needed if the UI is served from another origin
LLMLAB_CORS_ORIGINS=[]

# --- Database ---------------------------------------------------------------
# SQLite (default):
LLMLAB_DATABASE_URL=sqlite+aiosqlite:///./data/llmlab.db
# PostgreSQL (optional):
# LLMLAB_DATABASE_URL=postgresql+asyncpg://llmlab:llmlab@localhost:5432/llmlab
# Create tables at startup (set false when you manage schema with `alembic upgrade head`)
LLMLAB_AUTO_CREATE_TABLES=true

# --- Demo account (seeded at startup if missing) -----------------------------
LLMLAB_DEMO_USER_EMAIL=demo@llmlab.local
LLMLAB_DEMO_USER_PASSWORD=Demo@12345
LLMLAB_DEMO_USER_ROLE=admin
# Also seed engineer@ / researcher@ / viewer@llmlab.local with the same password
LLMLAB_SEED_ROLE_USERS=true

# --- Model providers ----------------------------------------------------------
# simulation | ollama | openai | huggingface   (users can override in Settings)
LLMLAB_LLM_PROVIDER=simulation
LLMLAB_OLLAMA_BASE_URL=http://localhost:11434
LLMLAB_OLLAMA_MODEL=llama3.2:1b
# Any OpenAI-compatible server (vLLM, LM Studio, llama.cpp server, Ollama /v1, hosted APIs)
LLMLAB_OPENAI_BASE_URL=http://localhost:8000/v1
LLMLAB_OPENAI_API_KEY=
LLMLAB_OPENAI_MODEL=gpt-4o-mini
# Local Hugging Face models (requires requirements-ml.txt). May download weights on first use.
LLMLAB_ENABLE_HF_MODELS=false
LLMLAB_HF_MODEL=HuggingFaceTB/SmolLM2-135M-Instruct
LLMLAB_HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLMLAB_HF_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLMLAB_PROVIDER_TIMEOUT_SECONDS=120

# --- Fine-tuning ----------------------------------------------------------------
LLMLAB_UPLOAD_MAX_BYTES=10485760
LLMLAB_ADAPTERS_DIR=./data/adapters
